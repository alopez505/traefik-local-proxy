# Local config - never commit
.env
.local/

# Generated local TLS material - never commit private keys or certs.
# Only certs/README.md is tracked.
certs/*
!certs/README.md
# Explicit, belt-and-suspenders on top of the blanket rule above, so key
# files and certificate-import staging directories are unambiguously
# excluded even if that blanket rule ever changes.
certs/*.key
certs/.certificate-import.*

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# mise local overrides
.mise.local.toml

# Traefik ACME/TLS generated files
acme.json

# Optional local auth middleware - may contain htpasswd credentials
dynamic/dashboard-auth.yml
dynamic/*auth*.yml
