# =============================================================================
#  Optionally copy to .env to override the defaults below.
#  .env is gitignored - never commit it.
# =============================================================================

# --- Network exposure ---------------------------------------------------------
# Bind address for the HTTP/HTTPS web ports. Keep at 127.0.0.1 unless you
# specifically need LAN/VM access - widening this does not by itself make a
# remote device reachable (see README "Configuration" for what else is
# needed), and it should generally not be combined with a bare dashboard (see
# TRAEFIK_DASHBOARD_ENABLED below). `mise run up`/`validate` print an advisory
# (non-blocking) warning if this resolves to a non-loopback address; that
# check only runs on mise-managed paths, not on a raw `docker compose up`.
TRAEFIK_WEB_BIND_ADDRESS=127.0.0.1

# Bind address for database TCP entrypoints (see the TRAEFIK_*_PORT vars
# below and "TCP database routing" in README). Independent from
# TRAEFIK_WEB_BIND_ADDRESS on purpose: enabling a database override file
# should never be silently widened just because the web ports were opened up,
# or vice versa. Widening this exposes every currently-enabled database
# override port to host interfaces, not just one.
TRAEFIK_TCP_BIND_ADDRESS=127.0.0.1

# HTTP entrypoint - redirects to HTTPS. Change if port 80 is taken.
TRAEFIK_HTTP_PORT=80

# HTTPS entrypoint. Dashboard at https://proxy.localtest.me
TRAEFIK_HTTPS_PORT=443

# Docker network Traefik and every routed project share. Advanced: this is a
# cross-project contract, not a local preference. Changing it requires every
# already-configured consuming project's own `networks: proxy: name:` (and
# any `traefik.docker.network` label) to change to match, or discovery breaks
# silently for everything already relying on the current name.
TRAEFIK_NETWORK_NAME=proxy

# Set to false to fully disable the dashboard/API router (both are reached
# through the same one labeled router). Recommended before enabling
# non-loopback web exposure.
TRAEFIK_DASHBOARD_ENABLED=true

# Optional TCP entrypoints for database containers routed through this proxy.
# Comment out the matching ports: lines in docker-compose.yml if these conflict
# with local database installs on this machine.
TRAEFIK_NEO4J_PORT=7687
TRAEFIK_MSSQL_PORT=1433
TRAEFIK_MYSQL_PORT=3306
TRAEFIK_POSTGRES_PORT=5432

# --- Log level ---------------------------------------------------------------
# Options: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
