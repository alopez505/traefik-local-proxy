# =============================================================================
#  Copy to .env and fill in.
#  .env is gitignored - never commit it.
# =============================================================================

# --- Traefik image version ---------------------------------------------------
# Pin a specific version for reproducibility.
# Browse tags: https://hub.docker.com/_/traefik/tags
TRAEFIK_VERSION=v3.7.1

# --- Shared proxy network ----------------------------------------------------
# Other Compose projects join this external network by name.
TRAEFIK_PROXY_NETWORK=proxy

# --- Network ports (all bound to 127.0.0.1) ----------------------------------
# HTTP entrypoint - redirects to HTTPS. Change if port 80 is taken.
TRAEFIK_HTTP_PORT=80

# HTTPS entrypoint. Dashboard at https://proxy.localtest.me
TRAEFIK_HTTPS_PORT=443

# Optional TCP entrypoints for database containers routed through this proxy.
# Comment out the matching ports: lines in docker-compose.yml if these conflict
# with local database installs on this machine.
TRAEFIK_NEO4J_PORT=7687
TRAEFIK_MSSQL_PORT=1433
TRAEFIK_MYSQL_PORT=3306
TRAEFIK_POSTGRES_PORT=5432

# --- Socket proxy ------------------------------------------------------------
# Docker socket filter that sits between Traefik and the Docker daemon.
# Image: https://github.com/Tecnativa/docker-socket-proxy
SOCKET_PROXY_VERSION=v0.4.2

# --- Log level ---------------------------------------------------------------
# Options: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO
